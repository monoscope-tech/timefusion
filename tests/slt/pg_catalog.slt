# pgAdmin calls set_config() with all-literal arguments on connect. DataFusion
# passes those as ColumnarValue::Scalar, not Array, which the UDF rejected:
# "set_config: second argument must be an array".

query T
SELECT set_config('bytea_output', 'escape', false)
----
escape

# The array path (a non-literal value) must keep working.
query T rowsort
SELECT set_config('search_path', c, false) FROM (VALUES ('a'), ('b')) t(c)
----
a
b

# pgAdmin's connect-time role probe. It computes can_signal_backend with
# array_contains(ARRAY(WITH RECURSIVE ...)), and DataFusion supports neither
# the array-subquery constructor ("Invalid function 'array'") nor that
# recursive CTE ("project index 0 out of bounds"), so the statement cannot be
# planned at all. PgCompatibilityHook answers it instead.

query ITBBBB
SELECT roles.oid AS id, roles.rolname AS name, roles.rolsuper AS is_superuser,
CASE WHEN roles.rolsuper THEN true ELSE roles.rolcreaterole END AS can_create_role,
CASE WHEN roles.rolsuper THEN true ELSE roles.rolcreatedb END AS can_create_db,
CASE WHEN 'pg_signal_backend' = any(array(WITH RECURSIVE cte AS (
  SELECT pg_roles.oid, pg_roles.rolname FROM pg_catalog.pg_roles WHERE pg_roles.oid = roles.oid
  UNION ALL
  SELECT m.roleid, pgr.rolname FROM cte cte_1
    JOIN pg_catalog.pg_auth_members m ON m.member = cte_1.oid
    JOIN pg_catalog.pg_roles pgr ON pgr.oid = m.roleid)
  SELECT rolname FROM cte)) THEN true ELSE false END AS can_signal_backend
FROM pg_catalog.pg_roles AS roles WHERE rolname = session_user
----
0 postgres true true true true

# pgAdmin's object-explorer schema query computes `is_catalog` with EXISTS in
# the SELECT LIST. DataFusion decorrelates EXISTS only in filter position, so a
# projection EXISTS reaches physical planning and fails with "Physical plan does
# not support logical expression Exists". ExistsInProjection rewrites it to the
# equivalent `(SELECT count(1) FROM q) > 0`, which DataFusion does decorrelate.

query TB
SELECT nsp.nspname AS schema_name,
  (nsp.nspname = 'pg_catalog' AND EXISTS
     (SELECT 1 FROM pg_catalog.pg_class WHERE relname = 'pg_class' AND relnamespace = nsp.oid LIMIT 1))
  OR (nsp.nspname = 'pgagent' AND EXISTS
     (SELECT 1 FROM pg_catalog.pg_class WHERE relname = 'pga_job' AND relnamespace = nsp.oid LIMIT 1))
  OR (nsp.nspname = 'information_schema' AND EXISTS
     (SELECT 1 FROM pg_catalog.pg_class WHERE relname = 'tables' AND relnamespace = nsp.oid LIMIT 1))
  AS is_catalog
FROM pg_catalog.pg_namespace nsp
ORDER BY nsp.nspname
----
pg_catalog true
public false

# NOT EXISTS in a projection must invert, not just be dropped.
query B
SELECT NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class WHERE relname = 'no_such_relation') AS absent
----
true

# PG's row_to_json(record) is to_json over a row. pgAdmin's dashboard calls it
# as `row_to_json(t)` over a subquery alias, which DataFusion rejects during SQL
# planning (see bare_relation_alias_is_still_unsupported) — the struct form is
# what TF supports.

query T
SELECT row_to_json(named_struct('total', 1, 'active', 2, 'idle', 3)) AS chart_data
----
{"active":2,"idle":3,"total":1}

# pgAdmin's dashboard shape: `row_to_json(t)` naming a whole row. PG allows a
# bare relation alias as a record; DataFusion rejects it during SQL planning, so
# RowToJsonRecordRewriter turns it into named_struct over the derived table's
# own column aliases before the statement is planned.

query TT
SELECT 'session_stats' AS chart_name, pg_catalog.row_to_json(t) AS chart_data
FROM (SELECT (SELECT count(*) FROM pg_catalog.pg_stat_activity) AS "total",
             (SELECT count(*) FROM pg_catalog.pg_stat_activity WHERE state = 'active') AS "active") t
----
session_stats {"active":0,"total":0}
