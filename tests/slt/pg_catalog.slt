SELECT count(*) FROM pg_locks
----
0

query I
SELECT count(*) FROM pg_prepared_xacts
----
0

query I
SELECT count(*) FROM pg_stat_replication
----
0

query I
SELECT count(*) FROM pg_available_extensions
----
