+    #[tokio::test]
+    async fn spill_reader_retains_disk_charge_until_closed() -> Result<()> {
+        enum Finish {
+            Cancel,
+            Eof,
+            SchemaMismatch,
+        }
+        let batch = RecordBatch::try_from_iter([(
+            "id",
+            Arc::new(Int32Array::from_iter_values(0..256)) as ArrayRef,
+        )])?;
+        let env = Arc::new(RuntimeEnv::default());
